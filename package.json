{
  "name": "the-oasis-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check-foundation.mjs",
    "build": "node scripts/build-site.mjs",
    "dev": "node scripts/serve.mjs",
    "pilot:build": "node pilot/scripts/build.mjs",
    "pilot:check": "tsc -p pilot/tsconfig.json --noEmit",
    "pilot:start": "node pilot/scripts/start.mjs",
    "pilot:test": "node pilot/scripts/test.mjs",
    "pilot:browser": "node pilot/scripts/browser-test.mjs",
    "pilot:backup": "node pilot/dist/server/admin.js backup",
    "pilot:restore": "node pilot/dist/server/admin.js restore",
    "pilot:soak": "node pilot/scripts/soak.mjs",
    "workshop:check": "node workshop/verify.mjs",
    "workshop:browser": "node workshop/verify.mjs --browser",
    "workshop:build": "node scripts/build-workshop.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@colyseus/core": "0.18.10",
    "@colyseus/schema": "5.0.8",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "6.0.2"
  }
}
